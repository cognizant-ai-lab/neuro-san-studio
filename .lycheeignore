# Localhost and local development URLs
http://localhost
http://127.0.0.1

# Private network addresses
http://192.168.
# Cloud metadata endpoint used as an SSRF test fixture (link-local, not browsable)
http://169.254.169.254

# Placeholder and example URLs
https://github.com/your-username/
https://mydomain.my.salesforce.com/
https://your-instance.service-now.com/
https://your-resource.openai.azure.com/
https://your-domain.atlassian.net
http://otherdomain.com/
file:///path/to/
http://arxiv.org/abs/$
https://test

# Sites with network-level blocks (not resolvable via --accept)
https://www.united.com/
https://mcp/

# Login-walled pages that redirect through an auth flow lychee can't resolve
https://admin.mistral.ai/

# URLs whose base path is not browsable (returns 400 or 404)
https://raw.githubusercontent.com/anthropics/skills/main/skills/
https://api.anthropic.com/
https://api.smith.langchain.com/
https://api.salesforce.com

# Ignores Jinja2 "{{.*}}" template pattern
file://.*%7B%7B.*%7D%7D

# Shell/template variable URLs (lychee cannot resolve these)
https://go.dev/dl/go\$

# For unit test, test_modified_arxiv_retriever
http://link/a
http://link/b
http://x/

# For unit test, test_safe_fetch domain-policy fixtures (never actually fetched;
# validate_url rejects them before any network call). lychee IDNA-normalizes hosts,
# so these are the punycode/trailing-dot forms it derives from example.com.,
# münchen.de and faß.de. Dots are escaped so the trailing-dot entry does not also
# match the plain https://example.com/... URLs used elsewhere.
https://example\.com\.
https://xn--mnchen-3ya\.de
https://xn--fa-hia\.de
# Root-only authorities used by the empty-canonical-host test (dots escaped).
http://\./
http://\.\./
