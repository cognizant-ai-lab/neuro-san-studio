# Nothing to route on: the Jev network must take the AAOSA fallback path, not pick a department.
{
    "agent": "industry/intranet_agents_with_tools",
    "timeout_in_seconds": 300,
    "success_ratio": "1/1",
    "interactions": [
        {
            "text": """
Can you help me with something?
""",
            "response": {
                "text": {
                    "gist": ["""
Asks the user what they need help with, possibly listing areas such as IT, HR or finance.
                             """]
                }
            }
        },
    ]
}
