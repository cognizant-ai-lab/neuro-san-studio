# Needs no department: the Jev network must take the none path (helper tools only).
{
    "agent": "industry/intranet_agents_with_tools",
    "timeout_in_seconds": 240,
    "success_ratio": "1/1",
    "interactions": [
        {
            "text": """
Hi! Thanks for the help yesterday.
""",
            "response": {
                "text": {
                    "gist": ["""
Responds to the thanks or greeting politely and offers further help.
                             """]
                }
            }
        },
    ]
}
