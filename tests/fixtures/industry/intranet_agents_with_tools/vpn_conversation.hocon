# The context-free follow-up, now with context: the Jev network must continue with Networking (same path) instead of asking what 'it' is.
{
    "agent": "industry/intranet_agents_with_tools",
    "timeout_in_seconds": 600,
    "success_ratio": "1/1",
    "interactions": [
        {
            "text": """
I can't connect to the VPN from home
""",
            "response": {
                "text": {
                    "gist": ["""
Gives VPN troubleshooting steps or asks for details about the VPN problem.
                             """]
                }
            }
        },
        {
            "text": """
It's still not working.
""",
            "response": {
                "text": {
                    "gist": ["""
Continues troubleshooting the VPN problem: asks for the VPN client, the error message or the next check, rather than asking what 'it' refers to.
                             """]
                }
            }
        },
    ]
}
