# A message that concerns more than one department: Jev must report it as unclear/ambiguous and the turn must take the AAOSA fallback path (the LLM sees the five heads, not the departments).
# Requires TYPESAFE_API_KEY. The sly_data assertions check the path the middleware recorded and the tools
# the LLM was given on that path (jev_turn.llm_tools).
{
    "agent": "industry/intranet_agents_with_jev_routing",
    "timeout_in_seconds": 300,
    "success_ratio": "1/1",
    "interactions": [
        {
            "text": """
I just got married. What do I need to update?
""",
            "response": {
                "text": {
                    "gist": ["""
Lists what an employee should update after getting married, covering at least two areas such as benefits (adding a spouse, life event), payroll or tax withholding, and personal details, possibly asking a question.
                             """]
                },
                "sly_data": {
                    "jev_turn": {
                        "path": { "value": "aaosa" },
                        "llm_tools": { "keywords": ["HR", "IT", "Finance"], "not_keywords": ["Benefits"] },
                    }
                }
            }
        },
    ]
}
