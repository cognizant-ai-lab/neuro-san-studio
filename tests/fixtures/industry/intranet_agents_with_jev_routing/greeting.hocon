# Needs no department: the Jev network must take the none path (helper tools only).
# Requires TYPESAFE_API_KEY. The sly_data assertions check the path the middleware recorded and the tools
# the LLM was given on that path (jev_turn.llm_tools).
{
    "agent": "industry/intranet_agents_with_jev_routing",
    "timeout_in_seconds": 240,
    "success_ratio": "1/1",
    "interactions": [
        {
            "text": """
Hi! Thanks for the help yesterday.
""",
            "response": {
                "text": {
                    "gist": ["""
Responds to the thanks or greeting politely and offers further help.
                             """]
                },
                "sly_data": {
                    "jev_turn": {
                        "path": { "value": "none" },
                        "llm_tools": { "keywords": ["URLProvider"], "not_keywords": ["HR", "Networking"] },
                    }
                }
            }
        },
    ]
}
