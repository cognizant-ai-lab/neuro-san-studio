# Clear single-department question: the Jev network must take the fast path to Payroll.
# Requires TYPESAFE_API_KEY. The sly_data assertions check the path the middleware recorded and the tools
# the LLM was given on that path (jev_turn.llm_tools).
{
    "agent": "industry/intranet_agents_with_jev_routing",
    "timeout_in_seconds": 240,
    "success_ratio": "1/1",
    "interactions": [
        {
            "text": """
How do I check my pay stub?
""",
            "response": {
                "text": {
                    "gist": ["""
Explains how an employee can view or access their pay stub (payslip): through the payroll system, HR portal or intranet page, possibly with a link.
                             """]
                },
                "sly_data": {
                    "jev_turn": {
                        "path": { "value": "jev" },
                        "department": { "value": "Payroll" },
                        "llm_tools": { "keywords": ["Payroll", "URLProvider"], "not_keywords": ["HR"] },
                    }
                }
            }
        },
    ]
}
