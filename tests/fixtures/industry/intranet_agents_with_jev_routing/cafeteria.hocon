# A message no department handles: the Jev network must not dispatch it to a department.
# Requires TYPESAFE_API_KEY. The sly_data assertions check the path the middleware recorded and the tools
# the LLM was given on that path (jev_turn.llm_tools).
{
    "agent": "industry/intranet_agents_with_jev_routing",
    "timeout_in_seconds": 300,
    "success_ratio": "1/1",
    "interactions": [
        {
            "text": """
Where can I find the cafeteria menu?
""",
            "response": {
                "text": {
                    "gist": ["""
Either points to where a cafeteria menu would be found on the intranet, or says this is not something it handles, possibly asking for the office location.
                             """]
                },
                "sly_data": {
                    "jev_turn": {
                        "path": { "not_value": ["jev", "same"] },
                    }
                }
            }
        },
    ]
}
