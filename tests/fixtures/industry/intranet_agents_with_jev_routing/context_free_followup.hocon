# A follow-up sent as the first message: without context the Jev network must fall back rather than guess a department.
# Requires TYPESAFE_API_KEY. The sly_data assertions check the path the middleware recorded and the tools
# the LLM was given on that path (jev_turn.llm_tools).
{
    "agent": "industry/intranet_agents_with_jev_routing",
    "timeout_in_seconds": 300,
    "success_ratio": "1/1",
    "interactions": [
        {
            "text": """
It's still not working.
""",
            "response": {
                "text": {
                    "gist": ["""
Asks what exactly is not working or which system or area the problem is about.
                             """]
                },
                "sly_data": {
                    "jev_turn": {
                        "path": { "value": "aaosa" },
                        "llm_tools": { "not_keywords": ["Networking"] },
                    }
                }
            }
        },
    ]
}
