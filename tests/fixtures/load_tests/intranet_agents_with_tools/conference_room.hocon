# Load-test prompt for the intranet_agents_with_tools agent.
# One interaction per file: each prompt is fired as an independent
# single-turn request. Agent-wide settings (failure_patterns,
# estimated_tokens_per_request) may be repeated in every file; they are
# merged across the folder.
# Schema: https://github.com/cognizant-ai-lab/neuro-san/blob/main/docs/test_case_hocon_reference.md
# Load-test keys: https://github.com/cognizant-ai-lab/neuro-san/blob/main/tests/load_tests/load_tests.md
{
    "agent": "industry/intranet_agents_with_tools",

    # Tokens per request, logged in the run config when no probe measured them.
    "estimated_tokens_per_request": 50000,

    # A response containing any of these is a failure even on HTTP 200.
    "failure_patterns": [
        "No fully-specified LLM found",
        "API key to be set as an environment variable",
        "Agent stopped due to exception"
    ],

    "interactions": [
        {
            "text": "How do I book a conference room for a team meeting next Tuesday?"
        }
    ]
}
