{
    include "registries/aaosa_basic.hocon"
    include "registries/expertise_scoping_instructions.hocon"
    include "config/llm_config.hocon"

    "max_steps": 30
    "max_execution_seconds": 300
    "tools": [
        {
            "name": "health_check_manager"
            "function": {
                "description": "Routes service health-check requests to the status reporter."
            }
            "instructions": ${expertise_scoping_instructions} """
Delegate every service health-check request to status_reporter. Return the reporter's operational status and
verification token exactly as supplied.
""" ${aaosa_instructions}
            "tools": ["status_reporter"]
        }
        {
            "name": "status_reporter"
            "function": ${aaosa_call} {
                "description": "Reports whether the demonstration service is operational."
            }
            "instructions": ${expertise_scoping_instructions} """
For a service health check, state clearly that the service is operational. Do not include a verification token.
""" ${aaosa_instructions}
            "tools": []
        }
    ]
}
