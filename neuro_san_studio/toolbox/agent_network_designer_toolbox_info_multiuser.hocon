# Tools the agent network designer may offer on a multi-user server. The Docker image in deploy/ selects this file
# with AGENT_NETWORK_DESIGNER_TOOLBOX_INFO_FILE, and a local run uses agent_network_designer_toolbox_info.hocon.
# Every user shares the server's files and API keys, so a tool belongs here only if it reads no server files and
# uses no server key.

{

    # ---------- Web Fetch Tool ----------

    # Fetches the content of a URL and returns its plain-text body.
    # Supports HTML pages and PDFs. Requires: beautifulsoup4, aiohttp, pypdf
    # It uses no key, accepts only http and https URLs (so it reads no files), and refuses addresses that are not
    # globally routable, such as private, loopback and link-local ones. See UrlPolicy and GlobalOnlyResolver in
    # neuro_san_studio/coded_tools/utils/.
    "web_fetch": {
        "class": "neuro_san_studio.coded_tools.web_fetch.WebFetch",
        "description": "Fetches the content of a URL and returns its plain-text body along with metadata. Supports HTML pages and PDF documents.",
        "parameters": {
            "type": "object",
            "properties": {
                "url": {
                    "type": "string",
                    "description": "The URL to fetch. Must use http or https scheme and be at most 250 characters."
                },
                "allowed_domains": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Optional list of domains to allow. If set, only URLs whose domain matches one of these will be fetched."
                },
                "blocked_domains": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Optional list of domains to block. URLs whose domain matches one of these will be rejected."
                },
                "max_content_chars": {
                    "type": "int",
                    "description": "Maximum number of characters to return from the fetched content. Defaults to 20000."
                }
            },
            "required": ["url"]
        }
    },

}
