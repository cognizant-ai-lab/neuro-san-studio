# MCP servers the agent network designer offers when it designs a network. Set
# AGENT_NETWORK_DESIGNER_MCP_INFO_FILE to use another list.
#
# An optional "tools" list limits which of a server's tools the designer shows; without one it shows them all.
# This file holds no keys. Leave out servers that need the client's key: the designer offers them whenever the
# client sends a key, and a listed one would also be tried without a key, which fails and is logged.
#
# Add only servers that need no API key, because this list also serves the multi-user Docker image. No two servers
# here do the same job. Firecrawl is left out because You.com covers web search and the toolbox's web_fetch reads
# pages.

{
    # Wolfram Cloud: symbolic math, scientific computation and curated facts.
    "https://agenttools.wolfram.com/mcp": {},

    # DeepWiki: questions about public GitHub repositories.
    "https://mcp.deepwiki.com/mcp": {},

    # You.com free tier: web search.
    "https://api.you.com/mcp?profile=free": {},

    # World Clock Pro: current time, time zone conversion and daylight saving time.
    "https://worldclock.pro/mcp": {},

    # FXMacroData keyless tier: US macroeconomic data and release calendars. Its other tools need an API key.
    "https://mcp.fxmacrodata.com": {
        "tools": ["latest_announcements", "indicator_query", "release_calendar", "press_releases", "market_sessions"]
    }
}
