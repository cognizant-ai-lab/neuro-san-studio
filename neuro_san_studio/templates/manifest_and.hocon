{
    # External agents available to the networks that agent_network_designer designs.
    # Read via AGENT_NETWORK_DESIGNER_MANIFEST_FILE (see
    # neuro_san_studio/agent_network_designer/tools/get_external_network.py), which defaults to this path.
    #
    # Add other manifests -- or individual "<group>/<network>.hocon": true entries --
    # to let the designer use them to compose networks.
    include "registries/generated/manifest.hocon"
}
