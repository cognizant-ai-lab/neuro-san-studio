# To use this agent network with Firecrawl Search, obtain an API key from: https://www.firecrawl.dev/
# Once you have the API key, set it using the FIRECRAWL_API_KEY environment variable.
# You can optionally set a custom search URL via the FIRECRAWL_URL environment variable.
# If FIRECRAWL_URL is not set, the default is: https://api.firecrawl.dev/v2/search
# You can also configure the request timeout (in seconds) using FIRECRAWL_TIMEOUT; the default is 120 seconds.

{
    # Optional metadata describing this agent network
    "metadata": {
        "description": "Agent network with a single agent that uses the Firecrawl Search API to search the web and read the content of the results in one call.",
        "tags": ["tool", "firecrawl_search"]
        "sample_queries": [
            "Search the web for the latest news on AI agents.",
            "Find the three best explanations of the Model Context Protocol and summarize what they actually say.",
            "Search code repositories for examples of retry logic with exponential backoff in Python."
        ]
    },

    include "registries/expertise_scoping_instructions.hocon",

    # Load the shared LLM configuration from a single source of truth.
    # This allows users to change the model in one file rather than
    # modifying the configuration for each agent network.
    # Note that the file path here is relative to the root level of the repo.
    include "config/llm_config.hocon",
    "tools": [
        # This first agent definition is regarded as the "Front Man", which
        # does all the talking to the outside world/client.
        #
        # Some disqualifications from being a front man:
        #   1) Cannot use a CodedTool "class" definition
        #   2) Cannot use a Tool "toolbox" definition
        #
        # Besides the first agent being the front man, these tool definitions
        # do not have to be in any particular order. How they are linked and
        # call each other is defined within their own specs.
        # This could be a graph, potentially even with cycles.
        {
            "name": "searcher",

            "function": {
                "description": "Assist caller with searching the web and reading the content of the results.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "user_inquiry": {
                            "type": "string",
                            "description": """
                            An inquiry from a user.
                            """
                        },
                    },
                    "required": ["user_inquiry"]
                }
            },

            "instructions": """
Use your tool to respond to the inquiry. Each search result may include the Markdown content of the page,
so answer from that content and cite the URLs you used.
""" ${expertise_scoping_instructions},
            "tools": ["firecrawl_search"]
        },
        {
            "name": "firecrawl_search",
            "toolbox": "firecrawl_search",
            "args": {
                # --- Optional Arguments ---

                # --- Request Configuration ---

                # Firecrawl Search API endpoint. Uncomment to override the env var FIRECRAWL_URL
                # (which itself defaults to https://api.firecrawl.dev/v2/search). Left commented so
                # that FIRECRAWL_URL is honored by default.
                # "firecrawl_url": "https://api.firecrawl.dev/v2/search",

                # Request timeout in seconds
                # This will override the env var FIRECRAWL_TIMEOUT
                # (default: 120.0)
                # Scraping the result pages takes longer than a snippet-only search, so keep this
                # generous when "scrape_content" is true.
                "firecrawl_timeout": 120.0,

                # --- Search Query Parameters ---

                # Search query string
                # "query": "<what_to_search_for>"
                # If specified, this will override the query provided by the LLM

                # Maximum number of search results to return
                "limit": 3,

                # Whether to return the cleaned Markdown of each result page along with the ranked results.
                # This is what distinguishes Firecrawl from snippet-only search tools. Set to false for
                # cheaper, faster results when the agent only needs titles, URLs and descriptions.
                "scrape_content": true,

                # Result source: "web" (default), "news", or "images"
                # "source": "web",

                # Specialized index to search instead of the general web:
                # "developer" (code repositories, issues and technical docs), "research" (papers), or "pdf"
                # "category": "developer",
                # Note: "research" narrows the web search to academic domains (arXiv, Nature, IEEE,
                # PubMed and similar); it does not return paper records.

                # For more query parameter options, see:
                # https://docs.firecrawl.dev/api-reference/endpoint/search
            }
        },
    ]
}
