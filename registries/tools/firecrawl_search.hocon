# Requirements to use this agent network:
#   - neuro-san >= 0.6.24
#   - This network targets the hosted Firecrawl MCP server, which works without an API key
#     (rate limited per IP per day, for both requests and credits).
#     To raise those limits, set FIRECRAWL_API_KEY and uncomment the http_headers block in
#     neuro_san_studio/mcp/mcp_info.hocon. The "tools" list in that same entry controls which
#     Firecrawl tools this agent sees; remove the key entirely to load every tool the server exposes.

{
    # Optional metadata describing this agent network
    "metadata": {
        "description": "Agent network with a single agent that can use the Firecrawl MCP server to search the web, read the content of the results, and scrape or parse specific pages.",
        "tags": ["tool", "firecrawl_search"]
        "sample_queries": [
            "Search the web for the latest news on AI agents.",
            "Find the three best explanations of the Model Context Protocol and summarize what they actually say.",
            "Scrape https://docs.firecrawl.dev/introduction and give me the key points in Markdown."
        ]
    },

    include "config/llm_config.hocon",

    "tools": [
        # This first agent definition is regarded as the "Front Man", which
        # does all the talking to the outside world/client.
        #
        # Some disqualifications from being a front man:
        #   1) Cannot use a CodedTool "class" definition
        #   2) Cannot use a Tool "toolbox" definition
        #
        # Besides the first agent being the front man, these tool definitions
        # do not have to be in any particular order. How they are linked and
        # call each other is defined within their own specs.
        # This could be a graph, potentially even with cycles.
        {
            "name": "web_searcher",

            "function": {
                "description": "Assist caller with searching the web, reading the content of the results, and scraping or parsing specific pages using Firecrawl.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "user_inquiry": {
                            "type": "string",
                            "description": "An inquiry from a user."
                        },
                    },
                    "required": ["user_inquiry"]
                }
            },

            "instructions": """
Use your tools to respond to the inquiry. Search results may include the Markdown content of each page,
so answer from that content and cite the URLs you used.
""",
            "tools": ["https://mcp.firecrawl.dev/v2/mcp"]
        },
    ]
}
