# Fraud War Room — Neuro SAN agent network
#
# This is the orchestration topology. Deterministic calculations are delegated
# to coded tools; agents reason over their outputs and the commander owns the
# investigator-facing response. The attacker/defender/simulator/challenger
# cycle is intentionally bounded by CycleGate and the network max_steps.
{
    include required(package("coded_tools:../config/fraud_defense_llm_config.hocon")),

    "metadata": {
        "description": "Neuro SAN-powered closed-loop adversarial fraud defense for synthetic North American banking investigations.",
        "tags": ["fraud", "banking", "adversarial", "governance", "simulation", "sly_data"],
        "sample_queries": [
            "Investigate CASE-0001 and recommend a control.",
            "Show the attack path, model disagreement, and counterfactual defense comparison for CASE-0001.",
            "Introduce a new attacker variation after the approved control enters shadow mode."
        ]
    },

    "max_steps": 80,
    "max_execution_seconds": 900,

    "tools": [
        {
            "name": "fraud_commander",
            "function": {"description": "Commands a bounded fraud investigation and returns the Decision Passport."},
            "instructions": """
You are the FRAUD COMMANDER for a synthetic NA BFS fraud-defense war room.
Own the investigation, keep the user-facing answer concise, and coordinate the
specialists through their tools. Always begin with get_case_context and
delegate to transaction_analyst. Pass the case ID to every delegate. Execute
delegations sequentially because each stage publishes shared evidence. For
MEDIUM+ risk also request customer, graph, timeline,
evidence, competing hypotheses, and the adversarial challenger. For HIGH or
CRITICAL risk, run attack reconstruction, the attacker/defender/simulator loop,
model routing, governance, and the decision governor. Never invent evidence;
use only coded-tool outputs. Never expose hidden ground truth or chain of thought.
Return a concise JSON object containing the risk level, decision, selected
defense, approval requirement, and Decision Passport reference.
""",
            "structure_formats": "json",
            "allow": {"to_downstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]},"from_downstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]},"to_upstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]}},
            "tools": ["get_case_context", "transaction_analyst", "customer_analyst", "entity_graph_analyst", "timeline_process_analyst", "evidence_analyst", "hypothesis_generator", "attack_reconstructor", "attacker_agent", "defender_agent", "counterfactual_simulator", "adversarial_challenger", "model_router", "policy_governance", "decision_governor", "outcome_learning"]
        },
        {
            "name": "transaction_analyst",
            "function": {"description": "Analyzes transaction velocity, amount anomalies, novelty, and sequences."},
            "instructions": """
You are the TRANSACTION ANALYST. Call analyze_transactions before making any
claim. Report exact signals, baselines, and reason codes. Do not calculate in
natural language and do not infer fraud from amount alone. Pass the concise
signal result upstream to the commander.
""",
            "allow": {"to_downstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]},"from_downstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]},"to_upstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]}},
            "tools": ["analyze_transactions"]
        },
        {
            "name": "customer_analyst",
            "function": {"description": "Distinguishes unusual activity from the customer's established behavior."},
            "instructions": """
You are the CUSTOMER ANALYST. Call analyze_customer and compare the observed
activity with historical location, channel, device, beneficiary, and amount
patterns. Preserve legitimate high-value and travel explanations as
counter-evidence when supported. Return facts only.
""",
            "allow": {"to_downstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]},"from_downstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]},"to_upstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]}},
            "tools": ["analyze_customer"]
        },
        {
            "name": "entity_graph_analyst",
            "function": {"description": "Investigates connected accounts, devices, sessions, beneficiaries, and campaigns."},
            "instructions": """
You are the ENTITY / GRAPH ANALYST. Call analyze_graph. The graph tool owns
traversal, paths, component membership, and centrality. Explain only the
returned graph findings, identify campaign signals, and name missing links.
""",
            "allow": {"to_downstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]},"from_downstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]},"to_upstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]}},
            "tools": ["analyze_graph"]
        },
        {
            "name": "timeline_process_analyst",
            "function": {"description": "Reconstructs payment event sequences and suspicious process stages."},
            "instructions": """
You are the TIMELINE / PROCESS ANALYST. Call reconstruct_timeline and describe
the sequence as access, setup, probing, extraction, and laundering phases when
the tool supports those labels. Do not claim intent from sequence alone.
""",
            "allow": {"to_downstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]},"from_downstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]},"to_upstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]}},
            "tools": ["reconstruct_timeline"]
        },
        {
            "name": "evidence_analyst",
            "function": {"description": "Separates evidence facts, counter-evidence, and missing evidence."},
            "instructions": """
You are the EVIDENCE ANALYST. Assemble the outputs from the transaction,
customer, graph, and timeline analysts. Keep facts, hypotheses, counter-
evidence, and missing evidence in separate sections. If the model opinions
disagree, request additional graph or customer evidence rather than averaging.
""",
            "allow": {"to_downstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]},"from_downstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]},"to_upstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]}},
            "tools": ["get_case_context", "analyze_transactions", "analyze_customer", "analyze_graph", "reconstruct_timeline", "assemble_evidence"]
        },
        {
            "name": "hypothesis_generator",
            "function": {"description": "Creates multiple competing explanations for observed activity."},
            "instructions": """
You are the HYPOTHESIS GENERATOR. Call generate_hypotheses and retain at least
one fraud explanation and one authorized-unusual explanation. Attach confidence
only when supported by returned features. Never collapse ambiguity prematurely.
""",
            "allow": {"to_downstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]},"from_downstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]},"to_upstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]}},
            "tools": ["generate_hypotheses"]
        },
        {
            "name": "attack_reconstructor",
            "function": {"description": "Reconstructs how an observed fraud attack could operate."},
            "instructions": """
You are the ATTACK RECONSTRUCTOR. Use the timeline and graph outputs to map the
observed attack stages and likely objective. Call reconstruct_attack. Distinguish
observed events from attacker hypotheses and preserve uncertainty.
""",
            "allow": {"to_downstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]},"from_downstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]},"to_upstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]}},
            "tools": ["reconstruct_attack", "reconstruct_timeline", "analyze_graph"]
        },
        {
            "name": "attacker_agent",
            "function": {"description": "Acts as an adaptive adversary attempting bounded control bypasses."},
            "instructions": """
You are the ATTACKER AGENT. Call cycle_gate before every proposed next round.
If continue is false, stop. Given the current defense, call attacker_challenge
and propose one concrete bypass variant. Do not produce harmful operational
instructions; keep the output at control-test level using synthetic variants.
Pass the challenge to the defender and simulator.
""",
            "allow": {"to_downstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]},"from_downstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]},"to_upstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]}},
            "tools": ["cycle_gate", "attacker_challenge", "defender_agent", "entity_graph_analyst", "adversarial_challenger"]
        },
        {
            "name": "defender_agent",
            "function": {"description": "Proposes risk-adaptive controls balancing prevention, friction, cost, and workload."},
            "instructions": """
You are the DEFENDER AGENT. Call propose_defenses for distinct candidates and
use the attacker challenge to revise the selected candidate with a transparent
sequence, beneficiary, temporal, or graph predicate. Ask the simulator to
compare the revised control. Never deploy a control directly.
""",
            "allow": {"to_downstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]},"from_downstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]},"to_upstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]}},
            "tools": ["propose_defenses", "counterfactual_simulator", "cycle_gate"]
        },
        {
            "name": "counterfactual_simulator",
            "function": {"description": "Simulates control candidates over synthetic cases and attack variants."},
            "instructions": """
You are the COUNTERFACTUAL SIMULATOR. Call simulate_defenses. Report computed
fraud prevented, loss prevented, false positives, customer friction,
investigator workload, operational cost, latency, and attack success. Compare
controls across variants and send the result to the challenger. Do not invent
metrics or use a single example number.
""",
            "allow": {"to_downstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]},"from_downstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]},"to_upstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]}},
            "tools": ["simulate_defenses", "adversarial_challenger"]
        },
        {
            "name": "adversarial_challenger",
            "function": {"description": "Challenges hypotheses, controls, and conclusions with contradictory evidence and bypasses."},
            "instructions": """
You are the ADVERSARIAL CHALLENGER. Call challenge_decision and inspect the
simulation results. Try to disprove the leading explanation and find a control
bypass. Use cycle_gate to decide whether another bounded adversarial round is
permitted. Return unresolved risks and evidence requests to the commander; the
commander may re-enter the attacker stage without creating an unbounded graph cycle.
""",
            "allow": {"to_downstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]},"from_downstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]},"to_upstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]}},
            "tools": ["challenge_decision", "cycle_gate"]
        },
        {
            "name": "model_router",
            "function": {"description": "Selects configured providers by risk tier and detects independent opinion disagreement."},
            "instructions": """
You are the MODEL ROUTER. Call route_models. For HIGH and CRITICAL cases,
retain independent provider or offline heuristic opinions. If disagreement is
above threshold, require more evidence and challenger review. Do not average
opinions into a false consensus.
""",
            "allow": {"to_downstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]},"from_downstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]},"to_upstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]}},
            "tools": ["route_models", "evidence_analyst", "adversarial_challenger"]
        },
        {
            "name": "policy_governance",
            "function": {"description": "Validates evidence, simulation, disagreement handling, human approval, and shadow-first policy."},
            "instructions": """
You are the POLICY / GOVERNANCE AGENT. Call check_governance. HIGH and CRITICAL
decisions require human approval; CRITICAL decisions cannot execute
autonomously. A proposed control must be simulated and may enter SHADOW only.
If checks fail, request more investigation.
""",
            "allow": {"to_downstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]},"from_downstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]},"to_upstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]}},
            "tools": ["check_governance", "route_models", "simulate_defenses"]
        },
        {
            "name": "decision_governor",
            "function": {"description": "Synthesizes the auditable final recommendation and Decision Passport."},
            "instructions": """
You are the DECISION GOVERNOR. Call create_decision_passport after reviewing
evidence, competing hypotheses, model disagreement, attacker analysis,
simulation, and governance. Return only a concise recommendation with reason
codes and approval/lifecycle status. Never expose chain-of-thought or hidden
ground truth.
""",
            "allow": {"to_downstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]},"from_downstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]},"to_upstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]}},
            "tools": ["create_decision_passport", "policy_governance", "outcome_learning"]
        },
        {
            "name": "outcome_learning",
            "function": {"description": "Records explicit predicted versus observed outcomes after human approval."},
            "instructions": """
You are the OUTCOME / LEARNING AGENT. Call record_outcome only after a human
approval or rejection. Record the attack pattern, selected defense, prediction
error, failure mode, and successful-defense flag as structured state. Do not
modify policy or code automatically.
""",
            "allow": {"to_downstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]},"from_downstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]},"to_upstream":{"sly_data":["fraud_case_id","fraud_cycle_state","fraud_war_room","decision_passport"]}},
            "tools": ["record_outcome"]
        },

        {"name": "get_case_context", "function": {"description": "Returns synthetic alert, customer, account, and transaction context.", "parameters": {"type": "object", "properties": {"case_id": {"type": "string", "description": "Synthetic case ID, for example CASE-0001."}}, "required": []}}, "class": "fraud_defense.neuro_tools.GetCaseContext"},
        {"name": "analyze_transactions", "function": {"description": "Calculates exact velocity, amount, novelty, sequence, and risk signals.", "parameters": {"type": "object", "properties": {"case_id": {"type": "string", "description": "Synthetic case ID."}}, "required": []}}, "class": "fraud_defense.neuro_tools.AnalyzeTransactions"},
        {"name": "analyze_customer", "function": {"description": "Calculates the customer's historical baseline.", "parameters": {"type": "object", "properties": {"case_id": {"type": "string", "description": "Synthetic case ID."}}, "required": []}}, "class": "fraud_defense.neuro_tools.AnalyzeCustomer"},
        {"name": "analyze_graph", "function": {"description": "Traverses the deterministic fraud campaign graph.", "parameters": {"type": "object", "properties": {"case_id": {"type": "string", "description": "Synthetic case ID."}}, "required": []}}, "class": "fraud_defense.neuro_tools.AnalyzeGraph"},
        {"name": "reconstruct_timeline", "function": {"description": "Reconstructs a chronological transaction process.", "parameters": {"type": "object", "properties": {"case_id": {"type": "string", "description": "Synthetic case ID."}}, "required": []}}, "class": "fraud_defense.neuro_tools.ReconstructTimeline"},
        {"name": "assemble_evidence", "function": {"description": "Separates supporting, counter-, and missing evidence from analyst outputs.", "parameters": {"type": "object", "properties": {"case_id": {"type": "string", "description": "Synthetic case ID."}}, "required": []}}, "class": "fraud_defense.neuro_tools.AssembleEvidence"},
        {"name": "generate_hypotheses", "function": {"description": "Returns competing authorized and fraud explanations.", "parameters": {"type": "object", "properties": {"case_id": {"type": "string", "description": "Synthetic case ID."}}, "required": []}}, "class": "fraud_defense.neuro_tools.GenerateHypotheses"},
        {"name": "reconstruct_attack", "function": {"description": "Returns the bounded attack reconstruction loop.", "parameters": {"type": "object", "properties": {"case_id": {"type": "string", "description": "Synthetic case ID."}}, "required": []}}, "class": "fraud_defense.neuro_tools.ReconstructAttack"},
        {"name": "attacker_challenge", "function": {"description": "Generates one bounded synthetic control-bypass variant.", "parameters": {"type": "object", "properties": {"case_id": {"type": "string", "description": "Synthetic case ID."}, "round": {"type": "integer", "description": "Bounded challenge round."}}, "required": []}}, "class": "fraud_defense.neuro_tools.AttackChallenge"},
        {"name": "propose_defenses", "function": {"description": "Returns distinct control candidates.", "parameters": {"type": "object", "properties": {"case_id": {"type": "string", "description": "Synthetic case ID."}}, "required": []}}, "class": "fraud_defense.neuro_tools.ProposeDefenses"},
        {"name": "simulate_defenses", "function": {"description": "Compares counterfactual controls over synthetic cases and variants.", "parameters": {"type": "object", "properties": {"case_id": {"type": "string", "description": "Synthetic case ID."}}, "required": []}}, "class": "fraud_defense.neuro_tools.SimulateDefenses"},
        {"name": "challenge_decision", "function": {"description": "Returns contradictory evidence and additional evidence requests.", "parameters": {"type": "object", "properties": {"case_id": {"type": "string", "description": "Synthetic case ID."}}, "required": []}}, "class": "fraud_defense.neuro_tools.ChallengeDecision"},
        {"name": "route_models", "function": {"description": "Routes risk-adaptive model opinions and detects disagreement.", "parameters": {"type": "object", "properties": {"case_id": {"type": "string", "description": "Synthetic case ID."}}, "required": []}}, "class": "fraud_defense.neuro_tools.RouteModels"},
        {"name": "check_governance", "function": {"description": "Checks explicit fraud-defense governance policies.", "parameters": {"type": "object", "properties": {"case_id": {"type": "string", "description": "Synthetic case ID."}}, "required": []}}, "class": "fraud_defense.neuro_tools.CheckGovernance"},
        {"name": "create_decision_passport", "function": {"description": "Creates the structured audit passport.", "parameters": {"type": "object", "properties": {"case_id": {"type": "string", "description": "Synthetic case ID."}}, "required": []}}, "class": "fraud_defense.neuro_tools.CreateDecisionPassport"},
        {"name": "record_outcome", "function": {"description": "Records observed outcomes after a human approval decision.", "parameters": {"type": "object", "properties": {"case_id": {"type": "string", "description": "Synthetic case ID."}, "approved": {"type": "boolean", "description": "Human approval flag."}}, "required": []}}, "class": "fraud_defense.neuro_tools.RecordOutcome"},
        {"name": "cycle_gate", "function": {"description": "Enforces a maximum number of adversarial rounds.", "parameters": {"type": "object", "properties": {"max_iterations": {"type": "integer", "description": "Maximum bounded rounds."}}, "required": []}}, "class": "fraud_defense.neuro_tools.CycleGate"}
    ]
}
