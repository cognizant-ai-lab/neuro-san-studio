{
    # This file is NOT an agent network HOCON.
    # It defines a set of key-value pairs for substitution, typically used in agent network HOCON files.
    # Each key can be referenced in agent configs using the ${key} syntax.
    # Do not define agents or tools directly here—this file only provides reusable values.

    # Similar to the default developer config, except that we provide more detailed setup information
    # for configurations for private LLM instances given by cloud providers.
    #
    # To most easily use this config, copy it over this directory's llm_config.hocon file.
    "llm_config": {
        "fallbacks": [
            {
                # Try OpenAI first
                "class": "azure-openai",

                # The OpenAI model behind the deployment below. It is not sent to Azure: it only prices
                # the tokens for cost reporting. Without it, usage on the Responses API is reported
                # under the deployment name with no price.
                "model_name": "gpt-5.2",

                                                                            # Values below can also come from env vars:
                # Your dev-ops set up for Azure OpenAI might vary w/rt
                # the deployment_name. Consult your dev-ops team as to how
                # they set up the deployment_name for the model of your choice.
                "deployment_name": "gpt-5-2",                               # AZURE_OPENAI_DEPLOYMENT_NAME

                # You *will* need to also set these env vars for Azure OpenAI such as:
                #   AZURE_OPENAI_API_KEY
                #   AZURE_OPENAI_ENDPOINT   (you could also set as "azure_endpoint" key in this config)
                # ... these will be provided by the dev-ops team that set up your Azure OpenAI instance.

                # You *might also* want to set these optional env vars for your Azure OpenAI such as:
                #   AZURE_OPENAI_REGION
                #   AZURE_OPENAI_RESOURCE_GROUP
                #   AZURE_OPENAI_MODEL_VERSION

                # Any env var mentioned above has been known to be emitted from TerraForm output (for instance).

                # Requests go to Azure's v1 API at AZURE_OPENAI_ENDPOINT + "/openai/v1/", which takes no
                # api-version. They use the Responses API by default. If your region or model does not
                # offer it, add "use_responses_api": false to stay on Chat Completions.

                # Try this one first, but move on to the next at any hint of a problem.
                "max_retries": 0
            },
            {
                # A private fallback LLM used if the default LLM is unavailable or cannot
                # complete a request. If you don't need a fallback provider, you can remove
                # this entire block.
                "class": "azure-openai",

                # The OpenAI model behind the deployment below, for cost reporting only.
                "model_name": "gpt-5.2",

                # Your dev-ops set up for Azure OpenAI might vary w/rt
                # the deployment_name. Consult your dev-ops team as to how
                # they set up the deployment_name for the model of your choice.
                "deployment_name": "gpt-5-2-b",                             # AZURE_OPENAI_DEPLOYMENT_NAME

                # No max_retries here.
                # If this one fails, there's nowhere else to go and you need more LLM instances.
            },

            # ... More for different llm + cloud provider combinations as they come
        ]
    }
}
